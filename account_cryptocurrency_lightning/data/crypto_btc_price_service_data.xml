<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default CoinGecko Price Service -->
        <record id="btc_price_service_coingecko_default" model="crypto.btc.price.service">
            <field name="name">CoinGecko (Default)</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
            <field name="service_type">coingecko</field>
            <field name="api_url">https://api.coingecko.com/api/v3/simple/price</field>
            <field name="rate_limit_seconds">60</field>
            <field name="timeout_seconds">10</field>
            <field name="cache_duration_minutes">5</field>
        </record>
    </data>
</odoo>