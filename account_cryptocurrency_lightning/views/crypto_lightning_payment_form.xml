<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crypto_lightning_payment_view_form" model="ir.ui.view">
            <field name="name">crypto.lightning.payment.form</field>
            <field name="model">crypto.lightning.payment.form</field>
            <field name="arch" type="xml">
                <form string="Lightning Payment">
                    <sheet>
                        <group>
                            <group>
                                <field name="address_id" readonly="1"/>
                                <field name="amount"/>
                                <field name="currency_id"/>
                                <field name="btc_price"/>
                            </group>
                            <group>
                                <field name="satoshis" string="Amount (satoshis)"/>
                                <field name="callback_url" invisible="1"/>
                                <field name="ln_payment_qrcode" widget="image"/>
                                <field name="ln_payment_ref" invisible="1"/>
                            </group>
                            <group>
                                <field name="lsp_id"/>
                            </group>
                        </group>
                        <footer>
                            <button name="action_pay_now" string="Pay Now" type="object" class="btn-primary"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>