<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crypto_lightning_address_view_form" model="ir.ui.view">
            <field name="name">crypto.lightning.address.form</field>
            <field name="model">crypto.lightning.address</field>
            <field name="arch" type="xml">
              <form string="Lightning Address">
                <header>
                  <button name="create_payment" string="💸 Create Payment" type="object" class="btn-primary"/>
                </header>
                <sheet>
                  <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" type="object" name="action_view_payments" icon="fa-money" invisible="payment_count == 0">
                      <field string="Payments" name="payment_count" widget="statinfo"/>
                    </button>
                    <button class="oe_stat_button" type="object" name="action_view_attachments" icon="fa-paperclip">
                      <field string="Attachments" name="attachment_count" widget="statinfo"/>
                    </button>
                  </div>
                  <group>
                    <group>
                      <field name="owner_id"/>
                      <field name="address"/>
                      <field name="type"/>
                    </group>
                    <group>
                      <field name="service_provider_id"/>
                      <field name="payment_count" invisible="1"/>
                      <field name="attachment_count" invisible="1"/>
                    </group>
                  </group>
                  <notebook>
                    <page string="Payments" invisible="payment_count == 0">
                      <field name="payment_ids" readonly="1">
                        <tree string="Lightning Payments" create="false" edit="false">
                          <field name="creation_date"/>
                          <field name="amount"/>
                          <field name="currency_id"/>
                          <field name="satoshis"/>
                          <field name="payment_status" decoration-success="payment_status == 'success'" decoration-warning="payment_status == 'pending'" decoration-muted="payment_status == 'draft'"/>
                          <field name="lsp_id"/>
                        </tree>
                      </field>
                    </page>
                    <page string="Notes">
                      <field name="notes" placeholder="Add internal notes about this Lightning address..."/>
                      <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                      </div>
                    </page>
                  </notebook>
                </sheet>
              </form>
            </field>
          </record>

        <record id="crypto_lightning_address_view_tree" model="ir.ui.view">
            <field name="name">crypto.lightning.address.tree</field>
            <field name="model">crypto.lightning.address</field>
            <field name="arch" type="xml">
                <tree string="Lightning Addresses">
                    <field name="owner_id"/>
                    <field name="address"/>
                    <field name="type"/>
                    <field name="service_provider_id"/>
                </tree>
            </field>
        </record>

        <record id="crypto_lightning_address_action" model="ir.actions.act_window">
            <field name="name">Lightning Addresses</field>
            <field name="res_model">crypto.lightning.address</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>