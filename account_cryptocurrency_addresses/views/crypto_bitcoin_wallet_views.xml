<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crypto_bitcoin_wallet_view_form" model="ir.ui.view">
            <field name="name">crypto.bitcoin.wallet.form</field>
            <field name="model">crypto.bitcoin.wallet</field>
            <field name="arch" type="xml">
                <form string="Bitcoin Wallets">
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="xpub"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Addresses">
                            <field name="address_ids">
                                <tree editable="bottom" string="Addresses">
                                    <field name="address"/>
                                    <field name="label"/>
                                    <field name="type"/>
                                    <field name="used"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Transactions">
                            <field name="sent_tx_ids">
                                <tree editable="bottom" string="Sent">
                                    <field name="date"/>
                                    <field name="tx_hash"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                            <field name="rcvd_tx_ids">
                                <tree editable="bottom" string="Received">
                                    <field name="date"/>
                                    <field name="tx_hash"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="XPub">
                            <group>
                                <field name="xpub_version"/>
                                <field name="xpub_depth"/>
                                <field name="xpub_parent_fingerprint"/>
                                <field name="xpub_child_number"/>
                                <field name="xpub_chain_code"/>
                                <field name="xpub_public_key"/>
                            </group>
                        </page>
                </notebook>
                </form>
            </field>
        </record>

        <record id="crypto_bitcoin_wallet_view_tree" model="ir.ui.view">
            <field name="name">crypto.bitcoin.wallet.tree</field>
            <field name="model">crypto.bitcoin.wallet</field>
            <field name="arch" type="xml">
                <tree string="Bitcoin wallets">
                    <field name="name"/>
                    <field name="owner_id"/>
                </tree>
            </field>
        </record>

        <record id="crypto_bitcoin_wallet_action" model="ir.actions.act_window">
            <field name="name">Bitcoin Wallets</field>
            <field name="res_model">crypto.bitcoin.wallet</field>
        </record>

    </data>
</odoo>
