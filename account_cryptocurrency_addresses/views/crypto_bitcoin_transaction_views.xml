<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crypto_bitcoin_transaction_view_form" model="ir.ui.view">
            <field name="name">crypto.bitcoin.transaction.form</field>
            <field name="model">crypto.bitcoin.transaction</field>
            <field name="arch" type="xml">
                <form string="Bitcoin Transaction">
                    <sheet>
                        <group>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="fee"/>
                            <field name="tx_hash" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="rbf_enabled" readonly="1"/>
                            <field name="lock_time" readonly="1"/>
                            <field name="mined_block" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="crypto_bitcoin_transaction_view_tree" model="ir.ui.view">
            <field name="name">crypto.bitcoin.transaction.tree</field>
            <field name="model">crypto.bitcoin.transaction</field>
            <field name="arch" type="xml">
                <tree string="Bitcoin Transactions">
                    <field name="date"/>
                    <field name="inputs"/>
                    <field name="outputs"/>
                    <field name="amount"/>
                    <field name="tx_hash"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>
        <record id="crypto_bitcoin_transaction_action" model="ir.actions.act_window">
            <field name="name">Bitcoin Transactions</field>
            <field name="res_model">crypto.bitcoin.transaction</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>