<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crypto_lightning_service_provider_form" model="ir.ui.view">
            <field name="name">crypto.lightning.service.provider.form</field>
            <field name="model">crypto.lightning.service.provider</field>
            <field name="arch" type="xml">
                <form string="Lightning Service Provider">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="grpc_url"/>
                            <field name="macaroon"/>
                        </group>
                        <group>
                            <field name="pubkey"/>
                            <field name="clearnet_url"/>
                            <field name="tor_url"/>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="crypto_lightning_service_provider_view_tree" model="ir.ui.view">
            <field name="name">crypto.lightning.service.provider.tree</field>
            <field name="model">crypto.lightning.service.provider</field>
            <field name="arch" type="xml">
                <tree string="Lightning Service Providers">
                    <field name="name"/>
                    <field name="grpc_url"/>
                    <field name="pubkey"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="crypto_lightning_service_provider_action" model="ir.actions.act_window">
            <field name="name">Lightning Service Providers</field>
            <field name="res_model">crypto.lightning.service.provider</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>