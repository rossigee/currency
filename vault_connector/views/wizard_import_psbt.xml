<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Import PSBT Wizard Form View -->
        <record id="wizard_import_psbt_form_view" model="ir.ui.view">
            <field name="name">wizard.import.psbt.form</field>
            <field name="model">wizard.import.psbt</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_import_psbt" string="Import PSBT" 
                                type="object" class="btn-primary" 
                                attrs="{'invisible': [('psbt_valid', '=', False)]}"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>Import Signed PSBT</h1>
                        </div>
                        
                        <div class="alert alert-info" role="alert">
                            <strong>📥 Import Signed PSBT:</strong><br/>
                            Import a PSBT that has been signed by one or more cosigners.
                            You can paste the PSBT data directly or upload a PSBT file.
                        </div>
                        
                        <group>
                            <field name="transaction_id" readonly="1"/>
                            <field name="import_method" widget="radio"/>
                        </group>
                        
                        <!-- Paste method -->
                        <group string="PSBT Data" attrs="{'invisible': [('import_method', '!=', 'paste')]}">
                            <field name="psbt_data" nolabel="1" widget="text" 
                                   placeholder="Paste the signed PSBT in base64 format here..."
                                   attrs="{'required': [('import_method', '=', 'paste')]}"/>
                        </group>
                        
                        <!-- Upload method -->
                        <group string="Upload PSBT File" attrs="{'invisible': [('import_method', '!=', 'upload')]}">
                            <field name="psbt_file" filename="psbt_filename"
                                   attrs="{'required': [('import_method', '=', 'upload')]}"/>
                            <field name="psbt_filename" invisible="1"/>
                        </group>
                        
                        <!-- Validation results -->
                        <group string="Validation Results" attrs="{'invisible': [('validation_message', '=', False)]}">
                            <div class="alert" role="alert" 
                                 attrs="{'class': 'alert-success' if psbt_valid else 'alert-danger'}">
                                <field name="validation_message" nolabel="1" readonly="1"/>
                            </div>
                            
                            <group attrs="{'invisible': [('psbt_valid', '=', False)]}">
                                <field name="signature_count" readonly="1"/>
                                <field name="is_complete" readonly="1" widget="boolean"/>
                            </group>
                        </group>
                        
                        <!-- Hidden fields -->
                        <field name="psbt_valid" invisible="1"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Import PSBT Action -->
        <record id="action_wizard_import_psbt" model="ir.actions.act_window">
            <field name="name">Import Signed PSBT</field>
            <field name="res_model">wizard.import.psbt</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="wizard_import_psbt_form_view"/>
        </record>

    </data>
</odoo>