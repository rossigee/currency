<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crypto_bitcoin_private_key_view_form" model="ir.ui.view">
            <field name="name">crypto.bitcoin.private.key.form</field>
            <field name="model">crypto.bitcoin.private.key</field>
            <field name="arch" type="xml">
                <form string="Bitcoin Private Keys">
                    <header>
                        <button name="action_create_public_key" string="Create Master Public Key" 
                                type="object" class="btn-primary" 
                                attrs="{'invisible': ['|', ('derived_xpub', '=', False), ('public_key_id', '!=', False)]}"/>
                        <button name="action_refresh_vault_status" string="Refresh Vault Status" 
                                type="object" class="btn-secondary" 
                                attrs="{'invisible': [('id', '=', False)]}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_public_key" type="object" 
                                    class="oe_stat_button" icon="fa-key"
                                    attrs="{'invisible': [('public_key_id', '=', False)]}">
                                <field name="public_key_id" widget="statinfo" string="Public Key"/>
                            </button>
                        </div>
                        
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="owner_id"/>
                                <field name="key_source" readonly="1"/>
                                <field name="token_uuid" readonly="1" attrs="{'invisible': [('id', '=', False)]}"/>
                                <field name="vault_status" readonly="1" attrs="{'invisible': [('id', '=', False)]}"/>
                            </group>
                            <group>
                                <field name="max_derivation_count"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Key Data" attrs="{'invisible': [('id', '=', False)]}">
                                <div class="alert alert-warning" role="alert">
                                    <strong>⚠️ SECURITY WARNING:</strong> 
                                    Private key data is sensitive. Only view when necessary and ensure your screen is not visible to others.
                                </div>
                                
                                <group string="Private Key Information">
                                    <field name="xprv" attrs="{'invisible': [('xprv', '=', False)]}" widget="CopyClipboardChar"/>
                                </group>
                                
                                <group string="Public Key Information">
                                    <field name="derived_xpub" attrs="{'invisible': [('derived_xpub', '=', False)]}" widget="CopyClipboardChar"/>
                                </group>
                                
                                <div class="alert alert-info" role="alert">
                                    <strong>🔐 Mnemonic &amp; Passphrase Security:</strong><br/>
                                    Your mnemonic phrase and passphrase (if used) are securely stored in Vault but are not displayed here for security reasons.
                                    They were shown only once during creation for you to write down.
                                    <br/><br/>
                                    <strong>Emergency Recovery:</strong> If needed, these can be accessed directly from Vault using token UUID: <code class="small"><field name="token_uuid" readonly="1" nolabel="1"/></code>
                                </div>
                            </page>
                            
                            <page string="Account Public Keys" attrs="{'invisible': [('derived_xpub', '=', False)]}">
                                <div class="alert alert-info" role="alert">
                                    <strong>📖 BIP44 Account Derivation:</strong><br/>
                                    Create account-level public keys (m/44'/0'/account') for different purposes or partners.
                                    Each account provides an isolated key space for payment processing.
                                </div>
                                
                                <div class="mt16 mb16">
                                    <button name="action_create_account_public_key_wizard" 
                                            string="Create Account Public Key" 
                                            type="object" 
                                            class="btn-primary"
                                            attrs="{'invisible': [('xprv', '=', False)]}"/>
                                </div>
                                
                                <field name="account_public_key_ids" readonly="1" nolabel="1">
                                    <tree create="false" delete="false">
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="account_index"/>
                                        <field name="derivation_path"/>
                                        <field name="fingerprint"/>
                                    </tree>
                                </field>
                            </page>
                            
                            <page string="Multisig Public Keys" attrs="{'invisible': [('derived_xpub', '=', False)]}" groups="account_cryptocurrency_bitcoin.group_bitcoin_advanced">
                                <div class="alert alert-info" role="alert">
                                    <strong>📖 BIP48 Multisig Derivation:</strong><br/>
                                    Create multisig public keys (m/48'/0'/account'/script_type') for different multisig setups.
                                    Each cosigner provides their own XPUB for the multisig wallet creation.
                                </div>
                                
                                <div class="mt16 mb16">
                                    <button name="action_create_multisig_public_key_wizard" 
                                            string="Create Multisig Public Key" 
                                            type="object" 
                                            class="btn-primary"
                                            attrs="{'invisible': [('xprv', '=', False)]}"/>
                                </div>
                                
                                <field name="multisig_public_key_ids" readonly="1" nolabel="1">
                                    <tree create="false" delete="false">
                                        <field name="name"/>
                                        <field name="account_index"/>
                                        <field name="script_type"/>
                                        <field name="cosigner_index"/>
                                        <field name="multisig_wallet_id"/>
                                        <field name="derivation_path"/>
                                        <field name="fingerprint"/>
                                    </tree>
                                </field>
                            </page>
                            
                            <page string="Derivation Paths" attrs="{'invisible': [('derived_xpub', '=', False)]}">
                                <div class="alert alert-info" role="alert">
                                    <strong>📖 Bitcoin Derivation Paths:</strong><br/>
                                    Different wallet software uses different BIP standard derivation paths from the same master seed.
                                    Each path creates a separate account with its own XPUB and address space.
                                </div>
                                
                                <group string="Account-Level XPUBs">
                                    <group>
                                        <field name="legacy_xpub" widget="CopyClipboardChar" attrs="{'invisible': [('legacy_xpub', '=', False)]}"/>
                                        <field name="nested_segwit_xpub" widget="CopyClipboardChar" attrs="{'invisible': [('nested_segwit_xpub', '=', False)]}"/>
                                    </group>
                                    <group>
                                        <field name="native_segwit_xpub" widget="CopyClipboardChar" attrs="{'invisible': [('native_segwit_xpub', '=', False)]}"/>
                                        <field name="taproot_xpub" widget="CopyClipboardChar" attrs="{'invisible': [('taproot_xpub', '=', False)]}"/>
                                    </group>
                                </group>
                                
                                <separator string="Sample Receive Addresses (First 3)" class="mt32"/>
                                <div class="row">
                                    <div class="col-6">
                                        <group string="Legacy (P2PKH) - Addresses start with '1'" attrs="{'invisible': [('legacy_addresses', '=', False)]}">
                                            <field name="legacy_addresses" widget="text" nolabel="1" readonly="1" class="text-monospace"/>
                                        </group>
                                        <group string="Native SegWit (P2WPKH) - Addresses start with 'bc1'" attrs="{'invisible': [('native_segwit_addresses', '=', False)]}">
                                            <field name="native_segwit_addresses" widget="text" nolabel="1" readonly="1" class="text-monospace"/>
                                        </group>
                                    </div>
                                    <div class="col-6">
                                        <group string="Nested SegWit (P2SH-P2WPKH) - Addresses start with '3'" attrs="{'invisible': [('nested_segwit_addresses', '=', False)]}">
                                            <field name="nested_segwit_addresses" widget="text" nolabel="1" readonly="1" class="text-monospace"/>
                                        </group>
                                        <group string="Taproot (P2TR) - Addresses start with 'bc1p'" attrs="{'invisible': [('taproot_addresses', '=', False)]}">
                                            <field name="taproot_addresses" widget="text" nolabel="1" readonly="1" class="text-monospace"/>
                                        </group>
                                    </div>
                                </div>
                                
                                <div class="alert alert-warning mt16" role="alert">
                                    <strong>⚠️ Important:</strong> These are sample addresses for demonstration. 
                                    Each derivation path provides an independent account space with unlimited addresses.
                                    Use the appropriate XPUB above to derive addresses in your wallet software.
                                </div>
                            </page>
                            
                            <page string="Notes">
                                <field name="notes" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="crypto_bitcoin_private_key_view_tree" model="ir.ui.view">
            <field name="name">crypto.bitcoin.private.key.tree</field>
            <field name="model">crypto.bitcoin.private.key</field>
            <field name="arch" type="xml">
                <tree string="Bitcoin Private Keys" create="false">
                    <field name="name"/>
                    <field name="owner_id"/>
                    <field name="key_source"/>
                    <field name="public_key_id"/>
                </tree>
            </field>
        </record>

        <record id="crypto_bitcoin_private_key_view_search" model="ir.ui.view">
            <field name="name">crypto.bitcoin.private.key.search</field>
            <field name="model">crypto.bitcoin.private.key</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="owner_id"/>
                    <field name="key_source"/>
                    <filter string="With Public Key" name="has_public_key" domain="[('public_key_id', '!=', False)]"/>
                    <filter string="Generated Keys" name="generated" domain="[('key_source', '=', 'generated')]"/>
                    <filter string="Imported Keys" name="imported" domain="[('key_source', 'in', ['mnemonic', 'xprv'])]"/>
                    <group expand="0" string="Group By">
                        <filter string="Key Source" name="group_by_source" context="{'group_by': 'key_source'}"/>
                        <filter string="Owner" name="group_by_owner" context="{'group_by': 'owner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action to create private key via wizard -->
        <record id="action_create_private_key_wizard" model="ir.actions.act_window">
            <field name="name">Create Private Key</field>
            <field name="res_model">wizard.create.private.key</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="crypto_bitcoin_private_key_action" model="ir.actions.act_window">
            <field name="name">Bitcoin Private Keys</field>
            <field name="res_model">crypto.bitcoin.private.key</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Bitcoin private key!
                </p>
                <p>
                    You can generate a new key, import from a mnemonic phrase, or import an existing XPRV.
                    All private key data is securely stored in Vault.
                </p>
                <p>
                    <a type="action" name="%(action_create_private_key_wizard)d" class="btn btn-primary">Create Private Key</a>
                </p>
            </field>
        </record>
    </data>
</odoo>