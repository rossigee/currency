<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Create Account Public Key Wizard Form View -->
        <record id="view_wizard_create_account_public_key_form" model="ir.ui.view">
            <field name="name">wizard.create.account.public.key.form</field>
            <field name="model">wizard.create.account.public.key</field>
            <field name="arch" type="xml">
                <form string="Create Account Public Key">
                    <header attrs="{'invisible': [('created_public_key_id', '=', False)]}">
                        <button name="action_view_public_key" 
                                string="View Public Key" 
                                class="btn-primary" 
                                type="object"/>
                        <button name="action_create_another" 
                                string="Create Another" 
                                class="btn-secondary" 
                                type="object"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <span attrs="{'invisible': [('created_public_key_id', '!=', False)]}">
                                    Create Account Public Key
                                </span>
                                <span attrs="{'invisible': [('created_public_key_id', '=', False)]}">
                                    Public Key Created Successfully
                                </span>
                            </h1>
                        </div>

                        <!-- Input Form (shown before creation) -->
                        <group attrs="{'invisible': [('created_public_key_id', '!=', False)]}">
                            <group>
                                <field name="private_key_id" readonly="1"/>
                                <field name="private_key_name" readonly="1"/>
                            </group>
                            <group>
                                <field name="account_index"/>
                                <field name="suggest_next_account"/>
                                <field name="next_available_account" readonly="1" 
                                       attrs="{'invisible': [('suggest_next_account', '=', False)]}"/>
                            </group>
                        </group>

                        <notebook attrs="{'invisible': [('created_public_key_id', '!=', False)]}">
                            <page string="Account Details">
                                <group>
                                    <field name="derivation_path" readonly="1"/>
                                    <field name="partner_id" options="{'no_create': True}"/>
                                    <field name="name_suffix"/>
                                </group>
                            </page>
                            
                            <page string="Existing Accounts">
                                <field name="existing_accounts" readonly="1" nolabel="1"/>
                            </page>
                            
                            <page string="Options">
                                <group>
                                    <field name="notes"/>
                                    <field name="create_sample_addresses"/>
                                    <field name="sample_address_count" 
                                           attrs="{'invisible': [('create_sample_addresses', '=', False)]}"/>
                                </group>
                            </page>
                        </notebook>

                        <!-- Results Display (shown after creation) -->
                        <div attrs="{'invisible': [('created_public_key_id', '=', False)]}">
                            <group>
                                <field name="success_message" readonly="1" nolabel="1" 
                                       widget="html" class="oe_read_only"/>
                            </group>
                            
                            <notebook>
                                <page string="XPUB Details">
                                    <group>
                                        <field name="derived_xpub" readonly="1" widget="CopyClipboardChar"/>
                                        <field name="derivation_path" readonly="1"/>
                                    </group>
                                </page>
                                
                                <page string="Sample Addresses" 
                                      attrs="{'invisible': [('sample_addresses', '=', False)]}">
                                    <field name="sample_addresses" readonly="1" nolabel="1" 
                                           widget="text" class="font-monospace small"/>
                                </page>
                            </notebook>
                        </div>

                        <!-- Hidden fields for form state management -->
                        <group invisible="1">
                            <field name="created_public_key_id"/>
                            <field name="derived_xpub"/>
                            <field name="sample_addresses"/>
                            <field name="success_message"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Create Account Public Key Wizard Action -->
        <record id="action_wizard_create_account_public_key" model="ir.actions.act_window">
            <field name="name">Create Account Public Key</field>
            <field name="res_model">wizard.create.account.public.key</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{}</field>
        </record>
    </data>
</odoo>