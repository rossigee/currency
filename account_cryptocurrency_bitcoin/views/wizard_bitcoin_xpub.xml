<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_bitcoin_xpub_view_form" model="ir.ui.view">
        <field name="name">wizard.bitcoin.xpub.form</field>
        <field name="model">wizard.bitcoin.xpub</field>
        <field name="arch" type="xml">
            <form string="Bitcoin XPUB Wizard">
                <group>
                    <field name="name"/>
                    <field name="xpub"/>
                </group>
                <footer>
                    <button string="Save" type="object" name="validate_and_save_xpub" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="crypto_bitcoin_public_key_wizard_action" model="ir.actions.act_window">
        <field name="name">New Bitcoin Public Key</field>
        <field name="res_model">wizard.bitcoin.xpub</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_name': 'New Bitcoin Public Key'
        }</field>
    </record>
</odoo>