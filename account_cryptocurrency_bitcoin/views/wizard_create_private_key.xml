<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="wizard_create_private_key_view_form" model="ir.ui.view">
            <field name="name">wizard.create.private.key.form</field>
            <field name="model">wizard.create.private.key</field>
            <field name="arch" type="xml">
                <form string="Create Bitcoin Private Key">
                    <!-- Hidden fields for view logic -->
                    <field name="created_private_key_id" invisible="1"/>
                    <field name="generated_mnemonic" invisible="1"/>
                    <field name="success_message" invisible="1"/>
                    
                    <!-- Input Phase -->
                    <group attrs="{'invisible': [('created_private_key_id', '!=', False)]}">
                        <group string="Basic Information">
                            <field name="name"/>
                            <field name="owner_id"/>
                            <field name="creation_method" widget="radio"/>
                        </group>
                        <group></group>
                    </group>
                    
                    <!-- Generate New Key -->
                    <div attrs="{'invisible': ['|', ('created_private_key_id', '!=', False), ('creation_method', '!=', 'generate')]}" class="row">
                        <div class="col-md-6">
                            <group string="Generation Options">
                                <field name="word_count" widget="radio"/>
                            </group>
                        </div>
                        <div class="col-md-6">
                            <div class="alert alert-info" role="alert">
                                <strong>📝 Generate New Key:</strong><br/>
                                A cryptographically secure private key and mnemonic will be generated for you.
                                The mnemonic will be shown only once - make sure to write it down!
                            </div>
                        </div>
                    </div>
                    
                    <!-- Import from Mnemonic -->
                    <div attrs="{'invisible': ['|', ('created_private_key_id', '!=', False), ('creation_method', '!=', 'import_mnemonic')]}" class="row">
                        <div class="col-md-6">
                            <group string="Mnemonic Import">
                                <field name="mnemonic_phrase" widget="text" placeholder="word1 word2 word3 ... word24"/>
                                <field name="bip39_passphrase" placeholder="Optional 25th word"/>
                            </group>
                        </div>
                        <div class="col-md-6">
                            <div class="alert alert-warning" role="alert">
                                <strong>⚠️ Import from Mnemonic:</strong><br/>
                                Enter your 12-24 word BIP39 mnemonic phrase. Include the optional passphrase if you used one.
                                The mnemonic and passphrase will be securely stored in Vault.
                            </div>
                        </div>
                    </div>
                    
                    <!-- Import from XPRV -->
                    <div attrs="{'invisible': ['|', ('created_private_key_id', '!=', False), ('creation_method', '!=', 'import_xprv')]}" class="row">
                        <div class="col-md-6">
                            <group string="Extended Private Key Import">
                                <field name="xprv_key" placeholder="xprv9s21ZrQH143K..."/>
                            </group>
                        </div>
                        <div class="col-md-6">
                            <div class="alert alert-warning" role="alert">
                                <strong>🔑 Import from XPRV:</strong><br/>
                                Enter your extended private key starting with 'xprv'. 
                                Only the XPRV will be stored (original mnemonic cannot be recovered).
                            </div>
                        </div>
                    </div>
                    
                    <!-- Results Phase -->
                    <div attrs="{'invisible': [('created_private_key_id', '=', False)]}">
                        <div class="row">
                            <div class="col-md-12">
                                <field name="success_message" widget="text" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        
                        <!-- Show generated mnemonic -->
                        <div attrs="{'invisible': [('generated_mnemonic', '=', False)]}" class="mt16">
                            <div class="row">
                                <div class="col-md-12">
                                    <h3>🔒 Your Mnemonic Phrase (WRITE THIS DOWN!)</h3>
                                    <field name="generated_mnemonic" widget="text" readonly="1" nolabel="1" 
                                           class="text-monospace bg-warning form-control" style="min-height: 80px;"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-md-12">
                                    <div class="alert alert-danger" role="alert">
                                        <strong>🚨 CRITICAL:</strong> This mnemonic phrase will never be shown again!<br/>
                                        Write it down on paper and store it in a secure location.<br/>
                                        Anyone with this phrase can access your Bitcoin.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <footer>
                        <!-- Input phase buttons -->
                        <button string="Create Private Key" name="action_create_private_key" type="object" 
                                class="btn-primary" attrs="{'invisible': [('created_private_key_id', '!=', False)]}"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" 
                                attrs="{'invisible': [('created_private_key_id', '!=', False)]}"/>
                        
                        <!-- Results phase buttons -->
                        <button string="Create Public Key" name="action_create_public_key" type="object" 
                                class="btn-primary" attrs="{'invisible': [('created_private_key_id', '=', False)]}"/>
                        <button string="View Private Key" name="action_view_private_key" type="object" 
                                class="btn-secondary" attrs="{'invisible': [('created_private_key_id', '=', False)]}"/>
                        <button string="Done" class="btn-secondary" special="cancel" 
                                attrs="{'invisible': [('created_private_key_id', '=', False)]}"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <record id="wizard_create_private_key_action" model="ir.actions.act_window">
            <field name="name">Create Bitcoin Private Key</field>
            <field name="res_model">wizard.create.private.key</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>