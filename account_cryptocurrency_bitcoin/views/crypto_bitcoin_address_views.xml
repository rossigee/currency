<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crypto_bitcoin_address_view_form" model="ir.ui.view">
            <field name="name">crypto.bitcoin.address.form</field>
            <field name="model">crypto.bitcoin.address</field>
            <field name="arch" type="xml">
                <form string="Bitcoin Addresses">
                    <header>
                        <button name="action_fetch_transactions" string="Fetch Transactions" 
                                type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="address"/>
                                <field name="wallet_id"/>
                                <field name="label"/>
                                <field name="type"/>
                                <field name="used"/>
                            </group>
                            <group>
                                <field name="transaction_count"/>
                                <field name="last_transaction_date"/>
                                <field name="balance"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Transactions">
                                <div class="alert alert-info" role="alert">
                                    <strong>📈 Transaction History:</strong> Transactions involving this address. Use "Fetch Transactions" to update from blockchain.
                                </div>
                                <field name="related_transaction_ids">
                                    <tree string="Related Transactions">
                                        <field name="date"/>
                                        <field name="tx_hash_display" string="Transaction Hash"/>
                                        <field name="amount"/>
                                        <field name="fee"/>
                                        <field name="confirmations"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="crypto_bitcoin_address_view_tree" model="ir.ui.view">
            <field name="name">crypto.bitcoin.address.tree</field>
            <field name="model">crypto.bitcoin.address</field>
            <field name="arch" type="xml">
                <tree string="Bitcoin Addresses">
                    <field name="address"/>
                    <field name="label" optional="show"/>
                    <field name="wallet_id" optional="show"/>
                    <field name="type" optional="show"/>
                    <field name="transaction_count" string="Txs" optional="show"/>
                    <field name="last_transaction_date" string="Last Tx" optional="hide"/>
                    <field name="balance" string="Balance (BTC)" sum="Total Balance" optional="show"/>
                    <field name="used" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="crypto_bitcoin_address_action" model="ir.actions.act_window">
            <field name="name">Bitcoin Addresses</field>
            <field name="res_model">crypto.bitcoin.address</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>