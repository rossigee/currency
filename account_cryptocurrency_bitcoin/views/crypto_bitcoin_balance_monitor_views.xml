<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Balance Monitor Tree View -->
        <record id="crypto_bitcoin_balance_monitor_tree_view" model="ir.ui.view">
            <field name="name">crypto.bitcoin.balance.monitor.tree</field>
            <field name="model">crypto.bitcoin.balance.monitor</field>
            <field name="arch" type="xml">
                <tree decoration-danger="priority == 'critical'" 
                      decoration-warning="priority == 'high'" 
                      decoration-muted="not active">
                    <field name="name"/>
                    <field name="multisig_wallet_id"/>
                    <field name="monitor_type"/>
                    <field name="priority" widget="badge"/>
                    <field name="current_balance" sum="Total Balance"/>
                    <field name="balance_trend" widget="badge" decoration-success="balance_trend == 'increasing'" decoration-danger="balance_trend == 'decreasing'"/>
                    <field name="last_check_date"/>
                    <field name="last_alert_date"/>
                    <field name="active" widget="boolean"/>
                    <button name="action_check_balance_now" string="Check Now" type="object" icon="fa-refresh" class="btn-sm"/>
                </tree>
            </field>
        </record>

        <!-- Balance Monitor Form View -->
        <record id="crypto_bitcoin_balance_monitor_form_view" model="ir.ui.view">
            <field name="name">crypto.bitcoin.balance.monitor.form</field>
            <field name="model">crypto.bitcoin.balance.monitor</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_check_balance_now" string="Check Balance Now" 
                                type="object" class="btn-primary"/>
                        <field name="active" widget="boolean_button" options="{'terminology': 'active'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(crypto_bitcoin_balance_alert_action)d" 
                                    type="action" class="oe_stat_button" 
                                    icon="fa-exclamation-triangle"
                                    context="{'default_monitor_id': active_id, 'search_default_monitor_id': active_id}">
                                <field name="total_alerts" widget="statinfo" string="Alerts"/>
                            </button>
                            <button name="%(crypto_bitcoin_balance_history_action)d" 
                                    type="action" class="oe_stat_button" 
                                    icon="fa-line-chart"
                                    context="{'default_monitor_id': active_id, 'search_default_monitor_id': active_id}">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">History</span>
                                </div>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1><field name="name" placeholder="Monitor Name"/></h1>
                        </div>

                        <group>
                            <group string="Basic Configuration">
                                <field name="multisig_wallet_id" options="{'no_create': True, 'no_edit': True}"/>
                                <field name="monitor_type"/>
                                <field name="priority"/>
                            </group>
                            <group string="Current Status">
                                <field name="current_balance" widget="monetary"/>
                                <field name="previous_balance" widget="monetary"/>
                                <field name="balance_trend" widget="badge"/>
                                <field name="avg_balance_24h" widget="monetary"/>
                                <field name="last_check_date"/>
                                <field name="last_alert_date"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Threshold Settings" invisible="monitor_type != \"threshold\"">
                                <group>
                                    <group string="Balance Thresholds (BTC)">
                                        <field name="critical_threshold"/>
                                        <field name="low_threshold"/>
                                        <field name="high_threshold"/>
                                    </group>
                                    <group string="Threshold Visualization">
                                        <div class="o_field_widget">
                                            <div style="background: #f8f9fa; padding: 15px; border-radius: 5px;">
                                                <div style="margin-bottom: 10px;">
                                                    <span style="color: #dc3545; font-weight: bold;">🔴 Critical:</span>
                                                    <span t-esc="critical_threshold or 'Not set'" style="font-family: monospace;"/> BTC
                                                </div>
                                                <div style="margin-bottom: 10px;">
                                                    <span style="color: #fd7e14; font-weight: bold;">🟠 Low:</span>
                                                    <span t-esc="low_threshold or 'Not set'" style="font-family: monospace;"/> BTC
                                                </div>
                                                <div style="margin-bottom: 10px; border: 2px solid #007bff; padding: 5px; border-radius: 3px;">
                                                    <span style="color: #007bff; font-weight: bold;">📊 Current:</span>
                                                    <span t-esc="current_balance" style="font-family: monospace; font-size: 16px;"/> BTC
                                                </div>
                                                <div>
                                                    <span style="color: #28a745; font-weight: bold;">🟢 High:</span>
                                                    <span t-esc="high_threshold or 'Not set'" style="font-family: monospace;"/> BTC
                                                </div>
                                            </div>
                                        </div>
                                    </group>
                                </group>
                            </page>

                            <page string="Change Settings" invisible="monitor_type != \"change\"">
                                <group>
                                    <group string="Change Thresholds">
                                        <field name="change_threshold_percent" suffix="%"/>
                                        <field name="change_threshold_absolute" suffix="BTC"/>
                                    </group>
                                    <group string="Help">
                                        <div class="alert alert-info">
                                            <h5>Balance Change Monitoring</h5>
                                            <p>This monitor will alert you when the wallet balance changes by:</p>
                                            <ul>
                                                <li>More than the specified percentage, OR</li>
                                                <li>More than the specified absolute amount</li>
                                            </ul>
                                            <p>Useful for detecting unexpected transactions or confirming expected deposits.</p>
                                        </div>
                                    </group>
                                </group>
                            </page>

                            <page string="Velocity Settings" invisible="monitor_type != \"velocity\"">
                                <group>
                                    <group string="Spending Velocity Limits">
                                        <field name="velocity_period_hours" suffix="hours"/>
                                        <field name="velocity_limit_btc" suffix="BTC"/>
                                    </group>
                                    <group string="Help">
                                        <div class="alert alert-warning">
                                            <h5>Velocity Monitoring</h5>
                                            <p>This monitor tracks spending rate and alerts when you exceed spending limits:</p>
                                            <ul>
                                                <li><strong>Period:</strong> Time window to track spending</li>
                                                <li><strong>Limit:</strong> Maximum BTC that can be spent in that period</li>
                                            </ul>
                                            <p><strong>Example:</strong> Alert if more than 0.1 BTC is spent in 24 hours</p>
                                        </div>
                                    </group>
                                </group>
                            </page>

                            <page string="Notifications">
                                <group>
                                    <group string="Email Notifications">
                                        <field name="notify_users_ids" widget="many2many_tags"/>
                                        <field name="notify_emails" placeholder="email1@example.com, email2@example.com"/>
                                        <field name="email_template_id"/>
                                    </group>
                                    <group string="Alert Frequency Control">
                                        <field name="alert_frequency_hours" suffix="hours"/>
                                        <field name="max_alerts_per_day"/>
                                        <field name="alerts_sent_today" readonly="1"/>
                                    </group>
                                </group>
                                
                                <div class="alert alert-info mt-3">
                                    <h5>Notification Settings</h5>
                                    <ul>
                                        <li><strong>Users:</strong> Select Odoo users to receive notifications</li>
                                        <li><strong>Additional Emails:</strong> Comma-separated list of external email addresses</li>
                                        <li><strong>Frequency:</strong> Minimum time between repeat alerts for the same condition</li>
                                        <li><strong>Daily Limit:</strong> Maximum number of alerts sent per day to prevent spam</li>
                                    </ul>
                                </div>
                            </page>

                            <page string="Recent Alerts">
                                <field name="alert_history_ids" nolabel="1">
                                    <tree create="false" delete="false">
                                        <field name="alert_date"/>
                                        <field name="alert_type" widget="badge"/>
                                        <field name="message"/>
                                        <field name="acknowledged" widget="boolean"/>
                                        <field name="acknowledged_by"/>
                                        <button name="action_acknowledge" string="Acknowledge" type="object" 
                                                class="btn-sm btn-secondary"
                                                invisible="acknowledged == true"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Balance History">
                                <field name="balance_history_ids" nolabel="1">
                                    <tree create="false" delete="false">
                                        <field name="check_date"/>
                                        <field name="balance"/>
                                        <field name="notes"/>
                                    </tree>
                                    <graph string="Balance Over Time" type="line">
                                        <field name="check_date" type="row"/>
                                        <field name="balance" type="measure"/>
                                    </graph>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Balance Monitor Kanban View -->
        <record id="crypto_bitcoin_balance_monitor_kanban_view" model="ir.ui.view">
            <field name="name">crypto.bitcoin.balance.monitor.kanban</field>
            <field name="model">crypto.bitcoin.balance.monitor</field>
            <field name="arch" type="xml">
                <kanban default_group_by="priority" class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="multisig_wallet_id"/>
                    <field name="monitor_type"/>
                    <field name="priority"/>
                    <field name="current_balance"/>
                    <field name="balance_trend"/>
                    <field name="last_check_date"/>
                    <field name="active"/>
                    <field name="total_alerts"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click #{not record.active.raw_value and 'o_kanban_muted' or ''}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <br/>
                                        <span class="text-muted">
                                            <field name="multisig_wallet_id"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_manage_button_section">
                                        <button name="action_check_balance_now" type="object" class="btn btn-sm btn-secondary" title="Check Balance">
                                            <i class="fa fa-refresh"/>
                                        </button>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="row">
                                        <div class="col-8">
                                            <strong>Balance:</strong><br/>
                                            <span style="font-family: monospace; font-size: 16px;">
                                                <field name="current_balance" widget="float" options="{'precision': 8}"/> BTC
                                            </span>
                                        </div>
                                        <div class="col-4 text-right">
                                            <field name="balance_trend" widget="badge"/>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <span class="badge badge-secondary">
                                            <field name="monitor_type"/>
                                        </span>
                                        <t t-if="record.total_alerts.raw_value > 0">
                                            <span class="badge badge-warning ml-1">
                                                <i class="fa fa-exclamation-triangle"/> <field name="total_alerts"/> alerts
                                            </span>
                                        </t>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="last_check_date" widget="relative"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Balance History Tree View -->
        <record id="crypto_bitcoin_balance_history_tree_view" model="ir.ui.view">
            <field name="name">crypto.bitcoin.balance.history.tree</field>
            <field name="model">crypto.bitcoin.balance.history</field>
            <field name="arch" type="xml">
                <tree create="false" delete="false">
                    <field name="check_date"/>
                    <field name="monitor_id"/>
                    <field name="balance"/>
                    <field name="notes"/>
                </tree>
            </field>
        </record>

        <!-- Balance History Graph View -->
        <record id="crypto_bitcoin_balance_history_graph_view" model="ir.ui.view">
            <field name="name">crypto.bitcoin.balance.history.graph</field>
            <field name="model">crypto.bitcoin.balance.history</field>
            <field name="arch" type="xml">
                <graph string="Balance History" type="line">
                    <field name="check_date" type="row" interval="hour"/>
                    <field name="balance" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Balance Alert Tree View -->
        <record id="crypto_bitcoin_balance_alert_tree_view" model="ir.ui.view">
            <field name="name">crypto.bitcoin.balance.alert.tree</field>
            <field name="model">crypto.bitcoin.balance.alert</field>
            <field name="arch" type="xml">
                <tree decoration-danger="alert_type == 'critical'" 
                      decoration-warning="alert_type in ['low', 'velocity']"
                      decoration-success="alert_type == 'high'"
                      decoration-muted="acknowledged">
                    <field name="alert_date"/>
                    <field name="monitor_id"/>
                    <field name="alert_type" widget="badge"/>
                    <field name="message"/>
                    <field name="acknowledged" widget="boolean"/>
                    <field name="acknowledged_by"/>
                    <button name="action_acknowledge" string="Acknowledge" type="object" 
                            class="btn-sm btn-secondary"
                            invisible="acknowledged == true"/>
                </tree>
            </field>
        </record>

        <!-- Search Views -->
        <record id="crypto_bitcoin_balance_monitor_search_view" model="ir.ui.view">
            <field name="name">crypto.bitcoin.balance.monitor.search</field>
            <field name="model">crypto.bitcoin.balance.monitor</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="multisig_wallet_id"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Critical Priority" name="critical" domain="[('priority', '=', 'critical')]"/>
                    <filter string="High Priority" name="high" domain="[('priority', '=', 'high')]"/>
                    <separator/>
                    <filter string="Threshold Monitors" name="threshold" domain="[('monitor_type', '=', 'threshold')]"/>
                    <filter string="Change Monitors" name="change" domain="[('monitor_type', '=', 'change')]"/>
                    <filter string="Velocity Monitors" name="velocity" domain="[('monitor_type', '=', 'velocity')]"/>
                    <separator/>
                    <filter string="Recent Alerts" name="recent_alerts" domain="[('last_alert_date', '>=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                        <filter string="Monitor Type" name="group_type" context="{'group_by': 'monitor_type'}"/>
                        <filter string="Wallet" name="group_wallet" context="{'group_by': 'multisig_wallet_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="crypto_bitcoin_balance_alert_search_view" model="ir.ui.view">
            <field name="name">crypto.bitcoin.balance.alert.search</field>
            <field name="model">crypto.bitcoin.balance.alert</field>
            <field name="arch" type="xml">
                <search>
                    <field name="monitor_id"/>
                    <field name="message"/>
                    <filter string="Unacknowledged" name="unacknowledged" domain="[('acknowledged', '=', False)]"/>
                    <filter string="Acknowledged" name="acknowledged" domain="[('acknowledged', '=', True)]"/>
                    <separator/>
                    <filter string="Critical" name="critical" domain="[('alert_type', '=', 'critical')]"/>
                    <filter string="Low Balance" name="low" domain="[('alert_type', '=', 'low')]"/>
                    <filter string="High Balance" name="high" domain="[('alert_type', '=', 'high')]"/>
                    <filter string="Velocity" name="velocity" domain="[('alert_type', '=', 'velocity')]"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('alert_date', '>=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
                    <filter string="This Week" name="week" domain="[('alert_date', '>=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Alert Type" name="group_type" context="{'group_by': 'alert_type'}"/>
                        <filter string="Monitor" name="group_monitor" context="{'group_by': 'monitor_id'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'alert_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_crypto_bitcoin_balance_monitor"
                  name="Balance Monitoring"
                  parent="menu_crypto_bitcoin_multisig"
                  sequence="30"/>

        <menuitem id="menu_crypto_bitcoin_balance_monitor_monitors"
                  name="Monitors"
                  parent="menu_crypto_bitcoin_balance_monitor"
                  action="crypto_bitcoin_balance_monitor_action"
                  sequence="10"/>

        <menuitem id="menu_crypto_bitcoin_balance_monitor_alerts"
                  name="Alerts"
                  parent="menu_crypto_bitcoin_balance_monitor"
                  action="crypto_bitcoin_balance_alert_action"
                  sequence="20"/>

        <menuitem id="menu_crypto_bitcoin_balance_monitor_history"
                  name="History"
                  parent="menu_crypto_bitcoin_balance_monitor"
                  action="crypto_bitcoin_balance_history_action"
                  sequence="30"/>

    </data>
</odoo>