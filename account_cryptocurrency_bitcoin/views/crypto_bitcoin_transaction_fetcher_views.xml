<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Transaction Fetcher Form View -->
        <record id="crypto_bitcoin_transaction_fetcher_form" model="ir.ui.view">
            <field name="name">crypto.bitcoin.transaction.fetcher.form</field>
            <field name="model">crypto.bitcoin.transaction.fetcher</field>
            <field name="arch" type="xml">
                <form string="Bitcoin Transaction Fetcher">
                    <header>
                        <button name="test_connection" string="Test Connection" type="object" class="btn-primary"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Service Name"/></h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="service_type"/>
                                <field name="network"/>
                                <field name="last_used" readonly="1"/>
                            </group>
                            <group>
                                <field name="rate_limit_delay"/>
                                <field name="max_retries"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Connection Settings">
                                <group>
                                    <group string="API Settings" invisible="service_type == \"electrum\"">
                                        <field name="base_url" required="service_type != 'electrum'"/>
                                    </group>
                                    <group string="Electrum Settings" invisible="service_type != \"electrum\"">
                                        <field name="electrum_host" required="service_type == 'electrum'"/>
                                        <field name="electrum_port" required="service_type == 'electrum'"/>
                                        <field name="use_ssl"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Status">
                                <field name="status_message" readonly="1" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Transaction Fetcher Tree View -->
        <record id="crypto_bitcoin_transaction_fetcher_tree" model="ir.ui.view">
            <field name="name">crypto.bitcoin.transaction.fetcher.tree</field>
            <field name="model">crypto.bitcoin.transaction.fetcher</field>
            <field name="arch" type="xml">
                <tree string="Bitcoin Transaction Fetchers">
                    <field name="name"/>
                    <field name="service_type"/>
                    <field name="network"/>
                    <field name="is_active"/>
                    <field name="last_used"/>
                    <button name="test_connection" string="Test" type="object" class="btn-sm btn-secondary"/>
                </tree>
            </field>
        </record>

        <!-- Transaction Fetcher Action -->
        <record id="crypto_bitcoin_transaction_fetcher_action" model="ir.actions.act_window">
            <field name="name">Transaction Fetchers</field>
            <field name="res_model">crypto.bitcoin.transaction.fetcher</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Bitcoin Transaction Fetcher
                </p>
                <p>
                    Transaction fetchers connect to external Bitcoin services (Blockstream API, Mempool.space, Electrum servers) 
                    to retrieve transaction data for addresses and wallets.
                </p>
            </field>
        </record>
    </data>
</odoo>