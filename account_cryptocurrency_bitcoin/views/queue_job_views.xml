<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Bitcoin Queue Job Tree View -->
        <record id="bitcoin_queue_job_tree_view" model="ir.ui.view">
            <field name="name">bitcoin.queue.job.tree</field>
            <field name="model">queue.job</field>
            <field name="inherit_id" ref="queue_job.view_queue_job_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="decoration-success">state == 'done'</attribute>
                    <attribute name="decoration-danger">state == 'failed'</attribute>
                    <attribute name="decoration-warning">state in ('pending', 'enqueued')</attribute>
                    <attribute name="decoration-info">state == 'started'</attribute>
                </xpath>
                <!-- Make state mandatory (always visible) with enhanced styling -->
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="widget">badge</attribute>
                    <attribute name="decoration-success">state == 'done'</attribute>
                    <attribute name="decoration-danger">state == 'failed'</attribute>
                    <attribute name="decoration-warning">state in ('pending', 'enqueued')</attribute>
                    <attribute name="decoration-info">state == 'started'</attribute>
                    <!-- No optional attribute = always visible -->
                </xpath>
                
                <!-- Set optional fields as requested -->
                <xpath expr="//field[@name='uuid']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <xpath expr="//field[@name='channel']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <xpath expr="//field[@name='company_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <xpath expr="//field[@name='model_name']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <!-- Make existing fields optional instead of adding duplicates -->
                <xpath expr="//field[@name='date_done']" position="attributes">
                    <attribute name="string">Execution Time</attribute>
                    <attribute name="optional">hide</attribute>
                </xpath>
            </field>
        </record>

        <!-- Bitcoin Queue Job Form View -->
        <record id="bitcoin_queue_job_form_view" model="ir.ui.view">
            <field name="name">bitcoin.queue.job.form</field>
            <field name="model">queue.job</field>
            <field name="inherit_id" ref="queue_job.view_queue_job_form"/>
            <field name="arch" type="xml">
                <!-- Add status header -->
                <xpath expr="//sheet" position="before">
                    <!-- Success status -->
                    <div class="alert alert-success" role="alert" 
                         invisible="state != \"done\"">
                        <strong>✅ Job Completed Successfully</strong>
                        <div>
                            <strong>Completed:</strong> <field name="date_done" readonly="1" nolabel="1"/>
                        </div>
                        <div invisible="result == false">
                            <strong>Result:</strong> <field name="result" readonly="1" nolabel="1"/>
                        </div>
                        <div invisible="result">
                            <strong>⚠️ No result returned</strong> - Job may have failed silently or returned early
                        </div>
                    </div>
                    
                    <!-- Failed status -->
                    <div class="alert alert-danger" role="alert" 
                         invisible="state != \"failed\"">
                        <strong>❌ Job Failed</strong>
                        <div>
                            <strong>Failed:</strong> <field name="date_done" readonly="1" nolabel="1"/>
                        </div>
                        <div invisible="result == false">
                            <strong>Error:</strong> <field name="result" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                    
                    <!-- Pending/In Progress status -->
                    <div class="alert alert-info" role="alert" 
                         invisible="state not in ['pending', 'enqueued', 'started']">
                        <strong>🔄 Job Status:</strong> <field name="state" readonly="1" nolabel="1" widget="badge"/>
                        <div invisible="date_enqueued == false">
                            <strong>Enqueued:</strong> <field name="date_enqueued" readonly="1" nolabel="1"/>
                        </div>
                        <div invisible="date_started == false">
                            <strong>Started:</strong> <field name="date_started" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                </xpath>
                
                <!-- Make timing fields invisible (used only in alerts above) -->
                <xpath expr="//field[@name='date_created']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='date_enqueued']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='date_started']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='date_done']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
            </field>
        </record>

        <!-- Bitcoin Job Queue Action with Custom Views -->
        <record id="bitcoin_queue_job_action" model="ir.actions.act_window">
            <field name="name">Bitcoin Job Queue</field>
            <field name="res_model">queue.job</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('func_string', 'ilike', 'bitcoin')]</field>
            <field name="context">{}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                                          (0, 0, {'view_mode': 'tree', 'view_id': ref('bitcoin_queue_job_tree_view')}),
                                          (0, 0, {'view_mode': 'form', 'view_id': ref('bitcoin_queue_job_form_view')})]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Bitcoin Jobs Found
                </p>
                <p>
                    Bitcoin background jobs will appear here when you import transactions or perform other background operations.
                </p>
            </field>
        </record>

    </data>
</odoo>