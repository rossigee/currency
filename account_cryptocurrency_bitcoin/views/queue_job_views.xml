<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Bitcoin Queue Job Tree View -->
        <record id="bitcoin_queue_job_tree_view" model="ir.ui.view">
            <field name="name">bitcoin.queue.job.tree</field>
            <field name="model">queue.job</field>
            <field name="inherit_id" ref="queue_job.view_queue_job_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="create">false</attribute>
                </xpath>
            </field>
        </record>

        <!-- Bitcoin Queue Job Form View -->
        <record id="bitcoin_queue_job_form_view" model="ir.ui.view">
            <field name="name">bitcoin.queue.job.form</field>
            <field name="model">queue.job</field>
            <field name="inherit_id" ref="queue_job.view_queue_job_form"/>
            <field name="arch" type="xml">
                <!-- Add help text for Bitcoin jobs -->
                <xpath expr="//sheet" position="before">
                    <div class="alert alert-info" role="alert">
                        <strong>Bitcoin Job Queue:</strong> This shows Bitcoin-related background jobs for transaction processing and wallet operations.
                    </div>
                </xpath>
            </field>
        </record>

        <!-- Bitcoin Job Queue Action with Custom Views -->
        <record id="bitcoin_queue_job_action" model="ir.actions.act_window">
            <field name="name">Bitcoin Job Queue</field>
            <field name="res_model">queue.job</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('func_string', 'ilike', 'bitcoin')]</field>
            <field name="context">{'search_default_pending': 1, 'search_default_failed': 1}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                                          (0, 0, {'view_mode': 'tree', 'view_id': ref('bitcoin_queue_job_tree_view')}),
                                          (0, 0, {'view_mode': 'form', 'view_id': ref('bitcoin_queue_job_form_view')})]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Bitcoin Jobs Found
                </p>
                <p>
                    Bitcoin background jobs will appear here when you import transactions or perform other background operations.
                </p>
            </field>
        </record>

    </data>
</odoo>