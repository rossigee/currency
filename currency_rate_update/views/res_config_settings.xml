<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='update_exchange_rates']" position="after">
                <setting id="currency_rates_autoupdate_setting"
                         string="Update Exchange Rates Automatically"
                         help="Update exchange rates automatically using OCA modules">
                    <field name="currency_rates_autoupdate" />
                    <span
                        class="fa fa-lg fa-building-o"
                        title="Values set here are company-specific."
                        role="img"
                        aria-label="Values set here are company-specific."
                        groups="base.group_multi_company"
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>